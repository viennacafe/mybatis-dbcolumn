<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vienna.demo.customer.mapper.CustomerMapper">

    <select id="findById"
            resultType="com.vienna.demo.customer.dto.CustomerDto">
        SELECT
            고객번호 as customerId,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        WHERE 고객번호 = #{customerId}
    </select>

    <select id="findAll"
            resultType="com.vienna.demo.customer.dto.CustomerDto">
        SELECT
            고객번호,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        ORDER BY 고객번호
    </select>

    <!-- 예제 2: resultMap으로 한글 컬럼 ↔ 영문 필드를 매핑 -->
    <resultMap id="customerResultMap"
               type="com.vienna.demo.customer.dto.CustomerResultMapDto">
        <id column="고객번호" property="customerId"/>
        <result column="고객명" property="customerName"/>
        <result column="생년월일" property="birthDate"/>
        <result column="사용여부" property="enabled"/>
    </resultMap>

    <select id="findByIdUsingResultMap" resultMap="customerResultMap">
        SELECT
            고객번호,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        WHERE 고객번호 = #{customerId}
    </select>

    <select id="findAllUsingResultMap" resultMap="customerResultMap">
        SELECT
            고객번호,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        ORDER BY 고객번호
    </select>

    <!-- 예제 3: SQL AS 별칭으로 한글 컬럼 ↔ 영문 필드를 매핑 -->
    <select id="findByIdUsingAlias"
            resultType="com.vienna.demo.customer.dto.CustomerAliasDto">
        SELECT
            고객번호 AS customerId,
            고객명 AS customerName,
            생년월일 AS birthDate,
            사용여부 AS enabled
        FROM 고객
        WHERE 고객번호 = #{customerId}
    </select>

    <select id="findAllUsingAlias"
            resultType="com.vienna.demo.customer.dto.CustomerAliasDto">
        SELECT
            고객번호 AS customerId,
            고객명 AS customerName,
            생년월일 AS birthDate,
            사용여부 AS enabled
        FROM 고객
        ORDER BY 고객번호
    </select>

</mapper>
