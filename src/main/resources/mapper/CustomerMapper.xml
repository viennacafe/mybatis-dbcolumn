<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.customer.mapper.CustomerMapper">

    <select id="findById"
            resultType="com.example.demo.customer.dto.CustomerDto">
        SELECT
            고객번호,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        WHERE 고객번호 = #{customerId}
    </select>

    <select id="findAll"
            resultType="com.example.demo.customer.dto.CustomerDto">
        SELECT
            고객번호,
            고객명,
            생년월일,
            사용여부
        FROM 고객
        ORDER BY 고객번호
    </select>

</mapper>
